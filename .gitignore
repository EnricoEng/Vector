# Ambiente virtual
#
# O padrão .venv* cobre ambientes separados por sistema operacional,
# como .venvMac, já que o mesmo projeto é usado no Windows e no macOS.
.venv*/
venv/
env/

# Cache do Python
__pycache__/
*.py[cod]
*$py.class

# Distribuição / empacotamento
build/
dist/
*.egg-info/

# Sistema operacional
.DS_Store

# Editores
.vscode/
.idea/
